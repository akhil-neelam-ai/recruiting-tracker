# Supabase → Project Settings → API Keys (or the Connect dialog).
# Use the publishable key. The older anon key name still works if that is what the dashboard shows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional legacy name. The app reads this only when the publishable key is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
